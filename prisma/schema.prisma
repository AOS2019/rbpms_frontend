generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  password  String
  updatedAt DateTime @updatedAt
  role      Role     @default(VIEWER)
  name      String
}

model Team {
  id   Int    @id @default(autoincrement())
  name String @unique

  bridgeId Int?

  bridge Bridge? @relation(fields: [bridgeId], references: [id])

  crewCode String? @unique

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Permanent crew
  members TeamMember[]

  crews Crew[]
}

model TeamMember {
  id Int @id @default(autoincrement())

  teamId Int
  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  employeeId Int
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  joinedAt DateTime @default(now())

  leftAt DateTime?

  createdAt DateTime @default(now())

  @@unique([teamId, employeeId])
}

model Crew {
  id Int @id @default(autoincrement())

  teamId Int
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  crewCode String

  description String?

  active Boolean @default(true)

  members CrewMember[]

  // Employees assigned to this crew in a Daily Report
  attendance EmployeeAttendance[]

  tasks DailyTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, crewCode])
}

model CrewMember {
  id Int @id @default(autoincrement())

  crewId Int
  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)

  employeeId Int
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  joinedAt DateTime @default(now())

  leftAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([crewId, employeeId])

  @@index([employeeId])
}

model Employee {
  id Int @id @default(autoincrement())

  staffId     String  @unique
  firstName   String
  lastName    String
  trade       String?
  designation String?
  phone       String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Permanent teams
  teams TeamMember[]

  attendance EmployeeAttendance[]

  crewMemberships CrewMember[]

  // operatedEquipment EquipmentUsage[] @relation("EquipmentOperator")
}

model EmployeeAttendance {
  id Int @id @default(autoincrement())

  dailyReportId Int
  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  employeeId Int
  employee Employee @relation(fields: [employeeId], references: [id])

  attendanceStatus AttendanceStatus @default(PRESENT)
  usages EquipmentUsage[]

  remarks String?

  // NEW
  assignedBridgeId Int?
  assignedBridge Bridge? @relation(fields: [assignedBridgeId], references: [id])

  assignedCrewId Int?
  assignedCrew Crew? @relation(fields: [assignedCrewId], references: [id])

  hoursWorked Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dailyReportId, employeeId])

  @@index([employeeId])
}

enum BridgeType {
  BRIDGE
  OVERBRIDGE
}

enum PierType {
  PIER
  ABUTMENT
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TECHNICIAN
  VIEWER
}

enum AttendanceStatus{

PRESENT

ABSENT

LEAVE

MISSION

SICK

JUSTIFIED_ABSENCE

}

model Section {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bridges   Bridge[]
}

model Bridge {
  id             Int             @id @default(autoincrement())
  pk_code        String          @unique

  teams Team[]
  employeeAttendance EmployeeAttendance[]

  bridgeType     BridgeType      @default(BRIDGE)

  sectionId      Int
  section        Section         @relation(fields: [sectionId], references: [id])
  
  piers          Pier[]

  totalCompleted Float           @default(0)
  totalPlanned   Float           @default(0)

  location       String?

  dailyReports DailyReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyPlanItems WeeklyPlanItem[]

  tasks DailyTask[]
}

model Element {
  id         Int         @id @default(autoincrement())
  name       String
  type       String?
  bridgeType BridgeType?
  status     String?

  tasks DailyTask[]
}

model Pier {
  id         Int      @id @default(autoincrement())
  pierNumber String // P1, P2, P3...
  type       PierType @default(PIER)

  bridgeId    Int
  height      Float?
  columnCount Int     @default(2)
  shape       String?

  createdAt DateTime @default(now())

  bridge  Bridge   @relation(fields: [bridgeId], references: [id])
  columns Column[]
}

model Column {
  id           Int      @id @default(autoincrement())
  columnNumber String
  pierId       Int
  shape        String?
  height       Float?
  createdAt    DateTime @default(now())
  pier         Pier     @relation(fields: [pierId], references: [id])
}

model DailyReport {
  id Int @id @default(autoincrement())

  date           DateTime
  siteEngineer   String
  foreman        String
  projectManager String
  weather        String

  bridgeId Int
  bridge   Bridge @relation(fields: [bridgeId], references: [id])

  // Daily attendance
  employeeAttendance EmployeeAttendance[]
  usages EquipmentUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      DailyTask[]
}

model DailyTask {
  id Int @id @default(autoincrement())

  dailyReportId Int
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id])

  crewId Int
  crew Crew @relation(fields: [crewId], references: [id])

  bridgeId Int
  bridge   Bridge @relation(fields: [bridgeId], references: [id])

  activityCode String?
  activity     String

  locationCode String

  elementId Int?
  element Element? @relation(fields: [elementId], references: [id])

  pierNumber String?

  quantityDone Float?

  unit String?

  concreteGrade String?

  status String

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dailyReportId])
  @@index([crewId])
  @@index([bridgeId])
}

model Equipment {
  id Int @id @default(autoincrement())

  equipmentCode String  @unique
  name          String
  type          String?
  status        String?

  createdAt DateTime @default(now())

  usages EquipmentUsage[]
}

model EquipmentUsage {
  id Int @id @default(autoincrement())

  dailyReportId Int
  dailyReport DailyReport @relation(fields:[dailyReportId], references:[id])

  employeeAttendanceId Int
  employeeAttendance EmployeeAttendance @relation(fields:[employeeAttendanceId], references:[id])
        
  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  // operatorId Int?
  // operator   Employee? @relation("EquipmentOperator", fields: [operatorId], references: [id])

  // crewMemberId Int?
  // crewMember CrewMember? @relation(fields: [crewMemberId], references: [id])

  // Meter readings
  startReading Float
  endReading   Float
  totalReading Float

  // Downtime
  standbyHours   Float @default(0)
  breakdownHours Float @default(0)

  // Useful for analysis
  fuelUsed Float? // Litres
  remarks  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@index([crewId])
  // @@index([equipmentId])
}

model WeeklyPlan {
  id Int @id @default(autoincrement())

  weekStart DateTime
  weekEnd   DateTime

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WeeklyPlanItem[]
}

model WeeklyPlanItem {
  id Int @id @default(autoincrement())

  weeklyPlanId Int
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id])

  bridgeId Int
  bridge   Bridge @relation(fields: [bridgeId], references: [id])

  elementType String

  locationCode String

  activity String

  activityCode String?

  predecessors Json?

  unit String

  dailyEntries Json?

  plannedQty Float

  actualQty Float @default(0)

  plannedStart  DateTime
  plannedFinish DateTime

  actualStart  DateTime?
  actualFinish DateTime?

  varianceReason String?

  completed Boolean @default(false)

  createdAt DateTime @default(now())
}

model Holiday {
  id Int @id @default(autoincrement())

  date DateTime @unique

  description String
}
