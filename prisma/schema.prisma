generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  password  String
  updatedAt DateTime @updatedAt
  role      Role     @default(VIEWER)
  name      String
}

model Section {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bridges   Bridge[]
}

model Element {
  id         Int             @id @default(autoincrement())
  name       String
  type       String?
  bridgeType       BridgeType?
  status     String?

  activities DailyActivity[]
}

model Pier {
  id          Int      @id @default(autoincrement())
  pierNumber  String   // P1, P2, P3...
  type        PierType @default(PIER)

  bridgeId    Int
  height      Float?
  columnCount Int      @default(2)
  shape       String?

  createdAt   DateTime @default(now())

  bridge      Bridge   @relation(fields: [bridgeId], references: [id])
  columns     Column[]
}

enum PierType {
  PIER
  ABUTMENT
}

model Bridge {
  id         Int        @id @default(autoincrement())
  pk_code    String     @unique
  bridgeType BridgeType @default(BRIDGE)
  sectionId  Int
  section    Section    @relation(fields: [sectionId], references: [id])
  activities     DailyActivity[]
  piers          Pier[]
  totalCompleted Float   @default(0)
  totalPlanned   Float   @default(0)
  location       String?

  dailyReports DailyReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyTeamTasks DailyTeamTask[]
}

model DailyReport {
  id             Int      @id @default(autoincrement())

  date           DateTime
  siteEngineer   String
  foreman         String
  projectManager String
  weather        String

  bridgeId       Int
  bridge         Bridge          @relation(fields: [bridgeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities     DailyActivity[]
  dailyTeamTasks DailyTeamTask[]
}

model DailyTeamTask {
  id Int @id @default(autoincrement())

  dailyReportId Int
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id])

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  teamId Int
  team   Team @relation(fields: [teamId], references: [id])

  bridgeId Int
  bridge   Bridge @relation(fields: [bridgeId], references: [id])

  equipmentId Int?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  hoursWorked Float
  remarks     String?

  createdAt DateTime @default(now())
}

model DailyActivity {
  id            Int         @id @default(autoincrement())
  activity  String?

  teamId Int
  team   Team @relation(fields: [teamId], references: [id])

  bridgeId Int
  bridge   Bridge @relation(fields: [bridgeId], references: [id])

  pierNumber    String?

  quantityDone  Float?
  unit          String?
  concreteGrade String?
  status        String
  
  dailyReportId Int
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id])

  elementId     Int?
  element       Element?     @relation(fields: [elementId], references: [id])

  createdAt     DateTime    @default(now())
  
}

model Team {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activities DailyActivity[]
  dailyTeamTasks DailyTeamTask[]
}

model Employee {
  id Int @id @default(autoincrement())

  staffId     String  @unique
  firstName   String
  lastName    String
  trade       String?
  designation String?
  phone       String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyTeamTasks DailyTeamTask[]
}

model Equipment {
  id Int @id @default(autoincrement())

  equipmentCode String  @unique
  name          String
  type          String?
  status        String?

  createdAt DateTime @default(now())

  dailyTeamTasks DailyTeamTask[]
}

model Column {
  id           Int      @id @default(autoincrement())
  columnNumber String
  pierId       Int
  shape        String?
  height       Float?
  createdAt    DateTime @default(now())
  pier         Pier     @relation(fields: [pierId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TECHNICIAN
  VIEWER
}

enum BridgeType {
  BRIDGE
  OVERBRIDGE
}
